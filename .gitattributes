# Normalize line endings in the repository; check out Windows-native files with CRLF.
* text=auto

*.cs           text eol=crlf
*.csproj       text eol=crlf
*.sln          text eol=crlf
*.props        text eol=crlf
*.targets      text eol=crlf
*.appxmanifest text eol=crlf
*.ps1          text eol=crlf
*.json         text eol=crlf
*.md           text eol=crlf
*.txt          text eol=crlf
*.yml          text eol=lf
*.yaml         text eol=lf

*.png  binary
*.ico  binary
*.jpg  binary
