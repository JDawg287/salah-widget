{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${city}", "weight": "Bolder", "maxLines": 1 },
    { "type": "TextBlock", "text": "${hijri}", "size": "Small", "isSubtle": true, "spacing": "None", "maxLines": 1 },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${next.label}", "size": "Small", "isSubtle": true },
                { "type": "TextBlock", "text": "${next.name}", "size": "Large", "weight": "Bolder", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${next.time}", "size": "ExtraLarge", "weight": "Bolder", "color": "Accent", "horizontalAlignment": "Right" },
                { "type": "TextBlock", "text": "${next.countdown}", "size": "Small", "horizontalAlignment": "Right", "spacing": "None" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "$data": "${row1}",
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${name}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "${time}", "weight": "${weight}", "color": "${color}", "isSubtle": "${subtle}", "horizontalAlignment": "Center", "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "$data": "${row2}",
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${name}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "${time}", "weight": "${weight}", "color": "${color}", "isSubtle": "${subtle}", "horizontalAlignment": "Center", "spacing": "None" }
          ]
        }
      ]
    }
  ]
}
