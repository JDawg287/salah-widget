{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${city}",
      "size": "Small",
      "isSubtle": true,
      "maxLines": 1
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${next.label}", "size": "Small", "isSubtle": true, "maxLines": 1 },
            { "type": "TextBlock", "text": "${next.name}", "size": "Large", "weight": "Bolder", "spacing": "None", "maxLines": 1 }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${next.time}", "size": "Large", "weight": "Bolder", "color": "Accent", "horizontalAlignment": "Right" },
            { "type": "TextBlock", "text": "${next.countdown}", "size": "Small", "horizontalAlignment": "Right", "spacing": "None" }
          ]
        }
      ]
    }
  ]
}
