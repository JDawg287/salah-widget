{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${city}", "weight": "Bolder", "maxLines": 1 },
    { "type": "TextBlock", "text": "${gregorian} · ${hijri}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${next.label}", "size": "Small", "isSubtle": true },
                { "type": "TextBlock", "text": "${next.name}", "size": "Large", "weight": "Bolder", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${next.time}", "size": "ExtraLarge", "weight": "Bolder", "color": "Accent", "horizontalAlignment": "Right" },
                { "type": "TextBlock", "text": "${next.countdown}", "size": "Small", "horizontalAlignment": "Right", "spacing": "None" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "$data": "${prayers}",
          "type": "Container",
          "style": "${style}",
          "spacing": "Small",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    { "type": "TextBlock", "text": "${name}", "weight": "${weight}", "color": "${color}", "isSubtle": "${subtle}" }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    { "type": "TextBlock", "text": "${arabic}", "isSubtle": true, "size": "Small" }
                  ]
                },
                {
                  "type": "Column",
                  "width": "70px",
                  "items": [
                    { "type": "TextBlock", "text": "${time}", "weight": "${weight}", "color": "${color}", "isSubtle": "${subtle}", "horizontalAlignment": "Right" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Imsak ${imsak} · Midnight ${midnight}",
      "size": "Small",
      "isSubtle": true,
      "separator": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${method} · Asr: ${school}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "${locationNote}",
      "size": "Small",
      "color": "Warning",
      "wrap": true,
      "spacing": "Small",
      "$when": "${approximate}"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Use precise location",
      "url": "ms-settings:privacy-location",
      "$when": "${approximate}"
    },
    {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "refresh"
    }
  ]
}
