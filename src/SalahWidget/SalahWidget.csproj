<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>SalahWidget</RootNamespace>
    <AssemblyName>SalahWidget</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Single-project MSIX packaging: the widget provider must have package identity -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <UseWinUI>false</UseWinUI>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Widgets component of the Windows App SDK, not the WinUI/AI/ML metapackage.
         Runtime declares the dependency on the installed Windows App Runtime 1.8 framework package.
         Base (transitive) brings the MSIX tooling and makeappx/signtool (Microsoft.Windows.SDK.BuildTools). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SalahWidget.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.json" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
